@page "/admin/user/creation"
@namespace RssSite.Pages.Users
@inherits UserCreationBase

<div class="userCreationPage">
    <h1 class="mainTitle">Create User</h1>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="formGroup">
        <label for="username" class="formLabel">Username:</label>
        <input type="text" id="username" @bind="NewUserRequest.Username" class="formControl" />
    </div>

    <div class="formGroup">
        <label for="email" class="formLabel">Email:</label>
        <input type="email" id="email" @bind="NewUserRequest.Email" class="formControl" />
    </div>

    <div class="formGroup">
        <label for="password" class="formLabel">Password:</label>
        <input type="password" id="password" @bind="NewUserRequest.Password" class="formControl" />
    </div>

    <div class="formGroup">
        <label for="role" class="formLabel">Role:</label>
        <select id="role" @bind="NewUserRequest.Role" class="formControl">
            <option value="User">User</option>
            <option value="Admin">Admin</option>
        </select>
    </div>

    <div class="buttonGroup">
        <button class="btnSecondary" @onclick="Cancel">Cancel</button>
        <button class="btnPrimary" @onclick="CreateUserAsync">Create</button>
    </div>
</div>